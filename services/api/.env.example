PORT=4400

ANTHROPIC_API_KEY=sk-ant-...

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=filebeat-8.15.0
ELASTICSEARCH_API_KEY=
# Container/service name the stale-approval check (and the watcher below)
# queries to see if an incident is still active. Must match whatever your
# log shipper tags the service as (e.g. container.name for Docker-shipped logs).
MONITORED_CONTAINER_NAME=ai_incident-demo-app-1

# The watcher polls the error rate on an interval and automatically triggers
# an investigation when it crosses the threshold, instead of waiting for a
# human to notice and POST /alerts manually. Only runs if ANTHROPIC_API_KEY
# is set.
WATCH_INTERVAL_MS=30000
WATCH_ERROR_RATE_THRESHOLD=0.1
WATCH_LOOKBACK_MINUTES=2

GITHUB_REPO=Adityayadav8957/AI-Incident-Response
GITHUB_TOKEN=

SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=C0123456789
SLACK_SIGNING_SECRET=...
