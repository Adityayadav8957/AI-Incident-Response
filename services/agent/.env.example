ANTHROPIC_API_KEY=sk-ant-...

ELASTICSEARCH_URL=http://localhost:9200
# Index or data stream name your log shipper writes to. Filebeat's default
# is filebeat-<version>; a different shipper will use a different name.
ELASTICSEARCH_INDEX=filebeat-8.15.0
# Only needed for a secured cluster (Elastic Cloud, self-hosted with security
# enabled, etc). Leave unset for the local unsecured Docker Elasticsearch.
ELASTICSEARCH_API_KEY=
